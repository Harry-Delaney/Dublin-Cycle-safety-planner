# Copy to .env and fill in real values. Never commit .env.

# Django
# Generate a key with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to True only when the site is served over HTTPS (enables secure cookies, HSTS, redirect)
DJANGO_HTTPS=False

# PostGIS (POSTGRES_HOST is the compose service name)
POSTGRES_DB=cyclesafe
POSTGRES_USER=cyclesafe
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
